<%- include('partials/head', { title: 'Login' }) %>

<h1 style="<%- s.h1 %>">Login to QuickBite</h1>
<p style="<%- s.muted %>">Welcome back. Sign in to place orders or manage your restaurant.</p>

<% if (Object.keys(errors).length) { %>
  <div style="<%- s.errBox %>">Please fix the errors below.</div>
<% } %>

<div style="<%- s.card %>">
  <form method="POST" action="/login">
    <input type="hidden" name="next" value="<%= next %>" />

    <label style="<%- s.label %>">Email</label>
    <input type="email" name="email" value="<%= values.email || '' %>" style="<%- s.input %>" />
    <% if (errors.email) { %><span style="<%- s.err %>"><%= errors.email %></span><% } %>

    <label style="<%- s.label %>">Password</label>
    <input type="password" name="password" style="<%- s.input %>" />
    <% if (errors.password) { %><span style="<%- s.err %>"><%= errors.password %></span><% } %>

    <button type="submit" style="<%- s.btn %>">Login</button>
  </form>

  <p style="margin-top:16px;">
    New here?
    <a href="/register" style="<%- s.btnGhost %>">Create an account</a>
  </p>
</div>

<%- include('partials/foot') %>