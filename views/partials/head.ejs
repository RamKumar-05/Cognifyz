<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= typeof title !== 'undefined' ? title : 'QuickBite' %></title>
</head>
<body style="<%- s.body %>">
  <nav style="<%- s.nav %>">
    <a href="/" style="<%- s.brand %>">QuickBite</a>
    <a href="/order" style="<%- s.navLink %>">Order</a>
    <% if (typeof currentUser !== 'undefined' && currentUser) { %>
      <% if (currentUser.role === 'owner') { %>
        <a href="/dashboard" style="<%- s.navLink %>">Dashboard</a>
        <a href="/admin/menu" style="<%- s.navLink %>">Menu</a>
        <a href="/restaurants/register" style="<%- s.navLink %>">Register Restaurant</a>
      <% } else { %>
        <a href="/my-orders" style="<%- s.navLink %>">My Orders</a>
      <% } %>
      <span style="color:#cfd8e0;font-size:.9rem;">Hi, <%= currentUser.name %></span>
      <form method="POST" action="/logout" style="display:inline;margin:0;">
        <button type="submit" style="background:none;border:0;color:#cfd8e0;cursor:pointer;font:inherit;">Logout</button>
      </form>
    <% } else { %>
      <a href="/login" style="<%- s.navLink %>">Login</a>
      <a href="/register" style="<%- s.navLink %>">Sign Up</a>
    <% } %>
  </nav>
  <main style="<%- s.main %>">