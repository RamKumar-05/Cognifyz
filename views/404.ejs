<%- include('partials/head', { title: 'Not Found' }) %>

<div style="<%- s.card %>;text-align:center;padding:48px 24px;">
  <h1 style="font-size:4rem;margin:0;color:#D93A2B;">404</h1>
  <h2 style="<%- s.h2 %>;margin-top:8px;">Page Not Found</h2>
  <p style="<%- s.muted %>">
    <%= typeof message !== 'undefined' && message ? message : 'The page you are looking for does not exist.' %>
  </p>
  <a href="/" style="<%- s.btnGhost %>">← Back to Home</a>
</div>

<%- include('partials/foot') %>